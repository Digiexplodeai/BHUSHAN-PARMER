rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    // For this prototype, any authenticated user can access admin features
    // In production, you would check a specific user document or custom claim
    function isAdmin() {
      return true; // request.auth != null;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only created manually in console
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{document=**} {
      allow create: if true; // Public can create appointments
      allow read, update, delete: if isAdmin();
    }

    match /treatments/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cancerTypes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videoTestimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{document=**} {
      allow read: if true; // Might want to filter by status in client
      allow write: if isAdmin();
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /internationalPatients/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /patientJourneys/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /milestones/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /highlights/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
